APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
FRONTEND_APP_URL=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Optional / unused for access-token verification (project uses ES256 JWKS).
# Kept for compatibility with older docs/tooling.
SUPABASE_JWT_SECRET=
# Public website contact form (Resend HTTP API). Server-side only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional public "Contact RealStick" actions. Leave blank to show a disabled state.
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_WHATSAPP=
PUBLIC_CONTACT_EMAIL=
